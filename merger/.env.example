# متغيرات البيئة لموقع دمج الفيديو — انسخه إلى .env واملأ القيم
# على Vercel: Settings → Environment Variables

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# اختياري: الرابط العام للموقع (يُستخرج تلقائيًا من الطلب على Vercel)
# PUBLIC_BASE_URL=

# اختياري: ضبط الحدود والترميز
# MAX_SOURCES=10
# SOURCE_MAX_MB=200
# OUTPUT_MAX_MB=150
# MAX_TOTAL_DURATION_SEC=600
# FFMPEG_PRESET=medium
