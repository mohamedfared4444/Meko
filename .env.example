# Meko — متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم — لا ترفع .env إلى Git أبدًا.

# ===== إلزامي =====
# رابط قاعدة Turso (libSQL)
TURSO_DATABASE_URL=
# توكن مصادقة Turso
TURSO_AUTH_TOKEN=

# ===== احتياطي (مستحسن) =====
# مفتاح kie.ai — يجعل التوليد يعمل فورًا دون إضافة مفاتيح يدويًا من اللوحة
KIE_API_KEY=
# مفتاح CometAPI كاحتياط إضافي (اختياري)
# COMETAPI_API_KEY=

# ===== اختياري =====
# حماية نقطة /mcp بمفتاح Bearer — يُنصح به عند النشر العام
# MCP_ACCESS_TOKEN=
# نافذة انتظار النتيجة داخل الطلب الواحد بالثواني (الافتراضي 45)
# MCP_MAX_WAIT_SECONDS=45
# رابط خدمة دمج الفيديو المنفصلة (مجلد merger/) إن نشرتها
# MERGER_API_BASE=
