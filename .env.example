# ============================================
# Meko — MCP Media Generator | متغيرات البيئة
# ضعها في Vercel → Settings → Environment Variables
# ============================================

# قاعدة بيانات Turso (إلزامي) — أنشئها مجانًا:
#   turso db create <name>
#   turso db show <name> --url
#   turso db tokens create <name>
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# خدمة دمج الفيديو (إلزامي لأداة merge_videos) — انشر مجلد merger/
# كمشروع Vercel مستقل ثم ضع رابطه هنا
MERGER_API_BASE=https://<your-merger-project>.vercel.app

# اختياري: إن ضُبط يُطلب Authorization: Bearer <token> على /mcp
# MCP_ACCESS_TOKEN=

# اختياري: أقصى نافذة انتظار داخل استدعاء MCP واحد بالثواني
# (الافتراضي 45 وهو آمن لحد 60 ثانية في خطة Vercel المجانية — ارفعه حتى 240 إن كان لديك Pro)
# MCP_MAX_WAIT_SECONDS=45

# اختياري: تجاوز أسماء الموديلات لدى المزودين
# KIE_IMAGE_MODEL=gpt-image-2-6/flare-text-to-image
# KIE_VIDEO_MODEL=grok-imagine-video-1-5-preview
# COMETAPI_IMAGE_MODEL=gpt-image-2.6-flare-text-to-image
# COMETAPI_VIDEO_MODEL=grok-imagine-video-1-5-preview
